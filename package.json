{
  "name": "kankakombat",
  "version": "1.0.0",
  "private": true,
  "description": "Kanka Kombat: Nutella Nights - an online co-op pixel-art beat-'em-up for the browser",
  "homepage": "https://xiondigital.net/kankakombat/",
  "repository": { "type": "git", "url": "https://github.com/XiONDiGiTaL/kankakombat.git" },
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "npm run sprites && npm run fonts && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "server": "tsx src/server/index.ts",
    "sprites": "tsx tools/sprites/build.ts",
    "sheets": "python tools/art/import_sheets.py",
    "props": "python tools/art/import_props.py",
    "hazards": "python tools/art/import_hazards.py",
    "npcs": "python tools/art/import_npcs.py",
    "stages": "python tools/art/import_stages.py",
    "web-assets": "python tools/art/make_web_assets.py",
    "fonts": "tsx tools/font/build.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:live": "node tools/verify-live.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.9.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "ws": "^8.18.0"
  }
}
